{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bricksmith:plan:v1",
  "title": "Bricksmith upright brick plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "source": {
      "enum": [
        "custom",
        "procedural",
        "mosaic",
        "relief"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "bricks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9_]{1,64}$"
          },
          "part": {
            "enum": [
              "3001",
              "3002",
              "3003",
              "3010",
              "3622",
              "3004",
              "3005",
              "3020",
              "3021",
              "3022",
              "3710",
              "3623",
              "3023",
              "3024"
            ]
          },
          "color": {
            "enum": [
              0,
              1,
              2,
              4,
              14,
              15,
              19,
              25,
              70,
              71,
              72,
              288
            ]
          },
          "x": {
            "type": "integer",
            "minimum": -128,
            "maximum": 128
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "z": {
            "type": "integer",
            "minimum": -128,
            "maximum": 128
          },
          "rotation": {
            "enum": [
              0,
              90
            ]
          }
        },
        "required": [
          "id",
          "part",
          "color",
          "x",
          "y",
          "z",
          "rotation"
        ]
      }
    }
  },
  "required": [
    "version",
    "name",
    "source",
    "description",
    "bricks"
  ]
}
