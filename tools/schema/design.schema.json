{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bricksmith:design:v1",
  "title": "Agent-authored volumetric Bricksmith design",
  "description": "x/z studs, y plates up; cell-center sampling. Ordered add/subtract/paint; voxels override last. Runtime additionally checks aggregate volume, node/depth/evaluation budgets, duplicate voxels, clipping and coordinate extents.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bricksmith.design.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 800,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -128,
            "maximum": 128
          },
          "minItems": 3,
          "maxItems": 3
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "min",
        "size"
      ]
    },
    "shapes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "paint"
                ]
              },
              "color": {
                "enum": [
                  0,
                  1,
                  2,
                  4,
                  14,
                  15,
                  19,
                  25,
                  70,
                  71,
                  72,
                  288
                ]
              },
              "shape": {
                "$ref": "#/$defs/shape"
              }
            },
            "required": [
              "op",
              "color",
              "shape"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "subtract"
              },
              "shape": {
                "$ref": "#/$defs/shape"
              }
            },
            "required": [
              "op",
              "shape"
            ]
          }
        ]
      }
    },
    "voxels": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1,
                  2,
                  4,
                  14,
                  15,
                  19,
                  25,
                  70,
                  71,
                  72,
                  288
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "at",
          "color"
        ]
      }
    },
    "packing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "mixed",
            "plates"
          ]
        },
        "maxPieces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": []
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxVoxels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maxEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24000000
        }
      },
      "required": []
    }
  },
  "required": [
    "schema",
    "name",
    "description",
    "bounds",
    "shapes"
  ],
  "$defs": {
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "box"
            },
            "min": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -256,
                "maximum": 256
              },
              "minItems": 3,
              "maxItems": 3
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 512
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "type",
            "min",
            "size"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ellipsoid"
            },
            "center": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -256,
                "maximum": 256
              },
              "minItems": 3,
              "maxItems": 3
            },
            "radii": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 256
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "type",
            "center",
            "radii"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cylinder"
            },
            "center": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -256,
                "maximum": 256
              },
              "minItems": 3,
              "maxItems": 3
            },
            "radius": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 256
            },
            "height": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 512
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            }
          },
          "required": [
            "type",
            "center",
            "radius",
            "height",
            "axis"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "union",
                "intersection",
                "difference"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/shape"
              },
              "minItems": 2,
              "maxItems": 32
            }
          },
          "required": [
            "type",
            "children"
          ]
        }
      ]
    }
  }
}
